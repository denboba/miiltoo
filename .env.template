# Google Maps API Configuration
# Copy this file to .env and fill in your actual API keys
# This file is a legacy template - use .env.example instead

# NOTE: Firebase configuration is handled by `lib/firebase_options.dart` (from FlutterFire)
# and does not need to be in this file.

# Google Maps API Keys (REQUIRED for maps functionality)
# Get these from: https://console.cloud.google.com/

# Google Maps JavaScript API Key (for Web)
GOOGLE_MAPS_WEB_API_KEY=YOUR_API_KEY_HERE

# Google Directions API Key (for route visualization on all platforms)
GOOGLE_DIRECTIONS_API_KEY=YOUR_API_KEY_HERE

# Android Google Maps API Key
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_API_KEY_HERE

# iOS Google Maps API Key  
GOOGLE_MAPS_IOS_API_KEY=YOUR_API_KEY_HERE
