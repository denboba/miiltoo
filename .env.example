# Google Maps API Configuration
# Copy this file to .env and fill in your actual API keys

# Google Maps JavaScript API Key (for Web)
# Get this from: https://console.cloud.google.com/
# Enable: Maps JavaScript API
GOOGLE_MAPS_WEB_API_KEY=YOUR_API_KEY_HERE

# Google Directions API Key (for route visualization)
# Get this from: https://console.cloud.google.com/
# Enable: Directions API
GOOGLE_DIRECTIONS_API_KEY=YOUR_API_KEY_HERE

# Android Google Maps API Key
# Get this from: https://console.cloud.google.com/
# Enable: Maps SDK for Android
# Restrict by: Android apps (add package name and SHA-1)
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_API_KEY_HERE

# iOS Google Maps API Key
# Get this from: https://console.cloud.google.com/
# Enable: Maps SDK for iOS
# Restrict by: iOS apps (add bundle ID)
GOOGLE_MAPS_IOS_API_KEY=YOUR_API_KEY_HERE
